FROM quay.io/fedora/fedora-toolbox:45
RUN dnf up -y
RUN dnf install -y bash-color-prompt podman nix nix-daemon
RUN dnf install -y https://github.com/coder/code-server/releases/download/v4.139.1/code-server-4.139.1-amd64.rpm
RUN setcap cap_setuid=ep /usr/bin/newuidmap
RUN setcap cap_setgid=ep /usr/bin/newgidmap
RUN useradd ide
COPY subuid /etc/subuid
COPY subuid /etc/subgid
USER ide
RUN mkdir -p /home/ide/.local/share
USER root
VOLUME /home/ide/.local/share/containers
RUN chown ide:ide /home/ide/.local/share/containers
